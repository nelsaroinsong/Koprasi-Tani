datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PETANI
  PEMBELI
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum RentalStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  phone        String?
  role         Role      @default(PEMBELI)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relasi
  kelompokTani   KelompokTani? @relation(fields: [kelompokTaniId], references: [id])
  kelompokTaniId String?

  products     Product[]
  rentals      AlsintanRental[]
  orders       Order[]

  @@map("users")
}

model KelompokTani {
  id             String    @id @default(uuid())
  nama           String
  desa           String
  kecamatan      String
  kabupaten      String    @default("Minahasa Utara")
  komoditasUtama String    // contoh: "Kelapa & Jagung"
  jumlahAnggota  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members        User[]
  products       Product[]

  @@map("kelompok_tani")
}

model Product {
  id             String        @id @default(uuid())
  nama           String
  deskripsi      String?
  kategori       String        // "Kelapa", "Jagung", "Olahan"
  hargaPerSatuan Decimal       @db.Decimal(12, 2)
  satuan         String        @default("kg") // "kg", "karung", "butir"
  stok           Int           @default(0)
  imageUrl       String?
  isTersedia     Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  petani         User          @relation(fields: [petaniId], references: [id])
  petaniId       String

  kelompokTani   KelompokTani? @relation(fields: [kelompokTaniId], references: [id])
  kelompokTaniId String?

  orderItems     OrderItem[]

  @@map("products")
}

model Alsintan {
  id                 String           @id @default(uuid())
  nama               String           // contoh: "Traktor Quick G1000", "Drone Sprayer"
  jenis              String           // "Traktor", "Drone", "Mesin Pemipil", "Mesin Pengering"
  spesifikasi        String?
  tarifSewaPerHari   Decimal          @db.Decimal(12, 2)
  status             String           @default("TERSEDIA") // "TERSEDIA", "DISEWA", "MAINTENANCE"
  imageUrl           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  rentals            AlsintanRental[]

  @@map("alsintan")
}

model AlsintanRental {
  id             String       @id @default(uuid())
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  durasiHari     Int
  totalBiaya     Decimal      @db.Decimal(12, 2)
  status         RentalStatus @default(PENDING)
  catatan        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id])
  userId         String

  alsintan       Alsintan     @relation(fields: [alsintanId], references: [id])
  alsintanId     String

  @@map("alsintan_rentals")
}

model Order {
  id              String      @id @default(uuid())
  invoiceNumber   String      @unique
  totalHarga      Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(PENDING)
  alamatPengiriman String?
  metodePembayaran String?    @default("QRIS")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id])
  userId          String

  items           OrderItem[]
  payment         Payment?

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  jumlah    Int
  harga     Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)

  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String

  product   Product  @relation(fields: [productId], references: [id])
  productId String

  @@map("order_items")
}

model Payment {
  id               String   @id @default(uuid())
  metode           String   // "QRIS", "BANK_TRANSFER"
  jumlah           Decimal  @db.Decimal(12, 2)
  midtransSnapToken String?
  transactionId    String?
  status           String   @default("PENDING")
  paymentDate      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order            Order    @relation(fields: [orderId], references: [id])
  orderId          String   @unique

  @@map("payments")
}
