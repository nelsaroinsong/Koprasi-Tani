datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PETANI
  PEMBELI
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String?
  googleId       String?       @unique
  name           String
  phone          String?
  address        String?
  role           Role          @default(PEMBELI)
  avatarUrl      String?
  isVerified     Boolean       @default(false)
  isOnboarded    Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relasi ke Produk komoditas yang dijual petani
  products       Product[]

  @@map("users")
}

model Product {
  id             String        @id @default(uuid())
  nama           String
  deskripsi      String?
  kategori       String        // "Kelapa", "Jagung", "Olahan"
  hargaPerSatuan Decimal       @db.Decimal(12, 2)
  satuan         String        @default("kg") // "kg", "karung", "butir"
  stok           Int           @default(0)
  imageUrl       String?
  isTersedia     Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  petani         User          @relation(fields: [petaniId], references: [id])
  petaniId       String

  @@map("products")
}
