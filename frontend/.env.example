# Salin menjadi .env (lokal) atau isi di Vercel → Project → Settings → Environment Variables.
# JANGAN commit nilai asli.

# --- Database PostgreSQL (Vercel: pakai Neon / Supabase / Vercel Postgres) ---
# Gunakan URL "pooled" untuk Vercel, contoh Neon:
# postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/koperasi?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL=

# --- Redis (Vercel: Upstash, format rediss://default:PASS@HOST:6379) ---
REDIS_URL=

# --- Auth (NextAuth / Auth.js) ---
AUTH_SECRET=            # buat dengan: npx auth secret   atau   openssl rand -base64 32
NEXTAUTH_SECRET=        # samakan dengan AUTH_SECRET
AUTH_TRUST_HOST=true
NEXTAUTH_URL=           # mis. https://koperasi-tani.vercel.app

# --- Google OAuth (login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (penyimpanan foto) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto

# --- Email notifikasi & OTP (Gmail App Password / SMTP lain) ---
SMTP_USER=
SMTP_PASS=

# --- Tugas terjadwal (pengingat & pembatalan tepat waktu) ---
CRON_SECRET=            # string acak panjang; Vercel Cron mengirimnya otomatis
# SCHEDULER_DISABLED=true   # hanya untuk server non-Vercel dengan >1 instance

# --- Opsional: peta & geocoding resmi ---
# NEXT_PUBLIC_MAPTILER_KEY=
# GOOGLE_MAPS_API_KEY=
